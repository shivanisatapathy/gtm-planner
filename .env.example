# Supabase — get these from your project's Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — for the AI "lateral idea" card in Ops Weekly Brief
# WARNING: Exposing API keys in a browser app is only safe for private internal tools.
# For public apps, route this through a server-side function.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here
